rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    // Pairing codes are exact-document lookups only; listing all codes is blocked.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == request.auth.uid;

      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Existing members can update the household. A new member may only add
      // themselves, and only while the household still has fewer than two users.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberUids
        || (
          request.resource.data.memberUids.size() <= 2
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
        )
      );

      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if signedIn() && request.auth.uid == memberId;
      }

      match /tasks/{taskId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /completions/{completionId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }
  }
}
