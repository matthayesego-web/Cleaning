rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function isHouseholdMember(householdId) {
      return signedIn()
        && request.auth.uid in get(householdPath(householdId)).data.memberUids;
    }

    function hasValidInviteFor(householdId) {
      return signedIn()
        && resource.data.pairingCode is string
        && exists(/databases/$(database)/documents/invites/$(resource.data.pairingCode))
        && get(/databases/$(database)/documents/invites/$(resource.data.pairingCode)).data.householdId == householdId;
    }

    // Pairing codes are exact-document lookups only; enumerating them is blocked.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == request.auth.uid;

      // A joining phone can read exactly the household referenced by its code.
      allow get: if signedIn() && (
        request.auth.uid in resource.data.memberUids || hasValidInviteFor(householdId)
      );
      allow list: if false;

      // Only the second phone may extend memberUids, and it may only add itself.
      // No member can silently replace/remove the other person or add a third.
      allow update: if signedIn()
        && resource.data.memberUids.size() < 2
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.size() <= 2
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt']);

      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId);

        // The joining transaction creates the new phone's own member document
        // at the same time as it adds that UID to the household.
        allow create, update: if signedIn()
          && request.auth.uid == memberId;
        allow delete: if signedIn()
          && request.auth.uid == memberId;
      }

      match /tasks/{taskId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /completions/{completionId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }
  }
}
